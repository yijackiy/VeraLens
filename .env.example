# VeraLens — required environment variables (Step 0.6)
#
# Copy to .env and fill in. .env is git-ignored; this file documents the NAMES
# only and must never contain a real value. Secrets are read from the
# environment, never from a committed config file.
#
#   cp .env.example .env

# --- Judge layer (evaluation only — never called in the inference path) ---

# gemini = Gemini 2.5 Flash API (default).
# local  = on-device Qwen3-VL judge, no data leaves the machine. Use this if
#          ethics approval rules out sending data to a third-party API.
JUDGE_PROVIDER=gemini

# Required when JUDGE_PROVIDER=gemini. Free tier: 10 req/min, 250 req/day.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Judge model. Pinned by name; the exact resolved version is recorded on every
# score row at call time, which is what makes results reproducible.
JUDGE_MODEL=gemini-2.5-flash

# Client-side throttle. Keep at or below the free-tier limits — backoff alone
# will not save a full batch run from a daily-quota exhaustion.
JUDGE_RPM=10
JUDGE_DAILY_QUOTA=250

# --- Storage for judge scores ---

# SQLAlchemy URL. Use Neon or Supabase free tier for anything that must survive
# until submission — Render's free Postgres expires after 30 days with no
# backups. Leave empty to fall back to a local SQLite file (data/judge.db),
# which is fine for development but is NOT the store for final thesis results.
#   postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=
