# The dataset is ~32k images and several GB — Docker does NOT read .gitignore,
# so without this line `COPY . .` bakes the whole thing into the image.
data/
venv/
.venv/
node_modules/
frontend/node_modules/
frontend/dist/
__pycache__/
**/__pycache__/
*.pyc
.git/
.env
backend/static/heatmaps/
showcase/data/img/
backups/
